# Applied over sdkconfig.xiao_esp32c5 by scripts/build_c5tako.py.
CONFIG_BUILD_CONFIG_TEMPLATE="C5TAKO"
CONFIG_BOARD_C5TAKO=y
CONFIG_C5TAKO_BATTERY_SCALE_PERMILLE=2000
CONFIG_WITH_SCREEN=y
CONFIG_TFT_WIDTH=240
CONFIG_TFT_HEIGHT=240
CONFIG_USE_TOUCHSCREEN=n
CONFIG_USE_JOYSTICK=y
CONFIG_L_BTN=23
CONFIG_C_BTN=4
CONFIG_U_BTN=24
CONFIG_R_BTN=0
CONFIG_D_BTN=28
CONFIG_JOYSTICK_COM_PIN=-1
CONFIG_HAS_BATTERY_ADC=y
CONFIG_ADC_BATTERY_PIN=6
CONFIG_HAS_BATTERY=n
CONFIG_RED_RGB_PIN=-1
CONFIG_GREEN_RGB_PIN=-1
CONFIG_BLUE_RGB_PIN=-1
CONFIG_NFC_CHAMELEON=y
CONFIG_NFC_PN532=n
CONFIG_HAS_SUBGHZ=y
CONFIG_SUBGHZ_SPI_HOST=2
CONFIG_SUBGHZ_SPI_MOSI_PIN=10
CONFIG_SUBGHZ_SPI_MISO_PIN=9
CONFIG_SUBGHZ_SPI_SCK_PIN=8
CONFIG_SUBGHZ_CSN_PIN=2
CONFIG_SUBGHZ_GDO0_PIN=12
CONFIG_SUBGHZ_GDO2_PIN=11
CONFIG_HAS_BADBLE=y
CONFIG_HAS_GPS=n
CONFIG_HAS_INFRARED=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_banshee_c5_factory.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_banshee_c5_factory.csv"
CONFIG_SD_SPI_CS_PIN=5
CONFIG_LV_PREDEFINED_DISPLAY_NONE=y
CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ST7789=y
CONFIG_LV_TFT_DISPLAY_SPI2_HOST=y
CONFIG_LV_HOR_RES_MAX=240
CONFIG_LV_VER_RES_MAX=240
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_DISPLAY_ORIENTATION_PORTRAIT=y
CONFIG_LV_TFT_DISPLAY_OFFSETS=y
CONFIG_LV_TFT_DISPLAY_X_OFFSET=0
CONFIG_LV_TFT_DISPLAY_Y_OFFSET=0
CONFIG_LV_DISP_SPI_MOSI=10
CONFIG_LV_DISPLAY_USE_SPI_MISO=y
CONFIG_LV_DISP_SPI_MISO=9
CONFIG_LV_DISP_SPI_CLK=8
CONFIG_LV_DISPLAY_USE_SPI_CS=y
CONFIG_LV_DISP_SPI_CS=7
CONFIG_LV_DISPLAY_USE_DC=y
CONFIG_LV_DISP_PIN_DC=1
CONFIG_LV_DISP_USE_RST=n
CONFIG_LV_DISP_ST7789_SOFT_RESET=y
CONFIG_LV_INVERT_COLORS=y
CONFIG_LV_DISP_BACKLIGHT_SWITCH=y
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=25
CONFIG_LV_TFT_USE_CUSTOM_SPI_CLK_DIVIDER=y
CONFIG_LV_TFT_SPI_CLK_DIVIDER_2=y
CONFIG_LV_TOUCH_CONTROLLER_NONE=y
